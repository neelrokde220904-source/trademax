# ===========================================
# India AI Trader — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.

# --- Angel One SmartAPI ---
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id
ANGEL_MPIN=your_mpin
ANGEL_TOTP_SECRET=your_totp_secret_key

# --- Anthropic ---
ANTHROPIC_API_KEY=your_anthropic_key

# --- News ---
NEWS_API_KEY=your_newsapi_key

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- Trading Config ---
PAPER_TRADING=true
# Required only if PAPER_TRADING=false. Keep this unset for paper trading.
LIVE_TRADING_ACKNOWLEDGEMENT=
INITIAL_CAPITAL=25000
MAX_CAPITAL_PER_TRADE_PCT=0.10
MAX_POSITIONS=8
MAX_DAILY_LOSS_PCT=0.03

# --- System ---
DATABASE_URL=sqlite:///./india_trader.db
LOG_LEVEL=INFO
DASHBOARD_PORT=8000

# Comma-separated values are supported.
GLOBAL_WATCHLIST=SPY,QQQ,AAPL,MSFT,GOOGL,AMZN,TSLA
